# Application
APP_NAME=AI BrandPilot
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO

# Ollama (the only LLM backend currently implemented -- see
# app/services/llm_service.py. Multi-provider support is a future
# direction, not yet built, so there is no LLM_PROVIDER switch here.)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Email notifications (Sprint 13): sent when a Wednesday draft is ready
# for your approval. Nothing is ever posted to LinkedIn automatically --
# the email just tells you a draft is waiting to be reviewed and posted
# by hand. Leave SMTP_HOST empty to disable notifications entirely.
#
# Example for Gmail: create an "App Password" (not your normal
# password) at https://myaccount.google.com/apppasswords, then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=True
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=<16-character app password>
#   SMTP_FROM_EMAIL=you@gmail.com
#   NOTIFY_TO_EMAIL=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
NOTIFY_TO_EMAIL=
