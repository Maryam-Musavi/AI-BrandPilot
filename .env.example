# Application
APP_NAME=AI BrandPilot
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO

# LLM
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/brandpilot.db

# OpenAI (optional)
OPENAI_API_KEY=

# LinkedIn Settings (placeholders for future integration)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=